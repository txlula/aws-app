{
  "name": "aws-app",
  "version": "1.0.0",
  "main": "index.js",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix",
    "*.{js,jsx,ts,tsx,json,css,md}": "prettier --write"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "day-metrics": "aws cloudwatch get-metric-data --start-time \"$(date -u -d '24 hours ago' +\"%Y-%m-%dT%H:%M:%SZ\")\" --end-time \"$(date -u +\"%Y-%m-%dT%H:%M:%SZ\")\" --metric-data-queries file://metrics.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/txlula/aws-app.git"
  },
  "author": "Lucy Nguyen",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/txlula/aws-app/issues"
  },
  "homepage": "https://github.com/txlula/aws-app#readme",
  "description": "",
  "devDependencies": {
    "cypress": "^15.11.0",
    "eslint": "^10.0.3",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1"
  }
}
